#!/bin/sh
# config.cgi - read/write the web-editable settings in config.env (sourced by start.sh).
#   GET (no action)      -> JSON of current values
#   GET ?action=save&... -> write config.env (applies on next reboot)
#   GET ?action=apply&.. -> write config.env and reboot now
# All settings are numeric, so values are validated as digits-only (no shell injection).
# NOTE: this busybox has no tr, head or basename - everything below is pure shell
# (IFS splitting + case + parameter expansion) or sed, both confirmed present.
CFG=/mnt/sdcard/cam/etc/config.env
KEYS="MD MD_STOCK MD_SENS MD_MRD MD_MRD_MIN MD_CELL_TH MD_MIN_CELLS MD_HOLD MD_MAXCLIP MD_AUDIO MD_MINFREE MD_KEEPDAYS OSD OSD_X OSD_Y OSD_SCALE OSD_ALPHA OSD_FG OSD_BG"

# default for a key missing from config.env (an older file): keep the rtspd built-in default
# so the page shows - and a later save keeps - what is actually running
def() {
  case "$1" in
    MD_SENS) echo 80 ;;
    MD_MRD) echo 1 ;;
    MD_MRD_MIN) echo 6 ;;
    *) echo 0 ;;
  esac
}

# current value of $1 from config.env: first "export KEY=NNN" line, digits only
cur() {
  [ -f "$CFG" ] || return 0
  while IFS= read -r line; do
    case "$line" in
      "export $1="*)
        v="${line#export $1=}"
        v="${v%%[!0-9]*}"
        if [ -n "$v" ]; then echo "$v"; return 0; fi
        ;;
    esac
  done < "$CFG"
}

# value of key $1 among the remaining args (the query pairs), digits only
qval() {
  key="$1"; shift
  for pair in "$@"; do
    case "$pair" in
      "$key="*)
        v="${pair#$key=}"
        v="${v%%[!0-9]*}"
        [ -n "$v" ] && { echo "$v"; return 0; }
        ;;
    esac
  done
}

# split QUERY_STRING on '&' once, into the script's own positional params
OLDIFS="$IFS"; IFS='&'; set -- $QUERY_STRING; IFS="$OLDIFS"

ACTION=""
for pair in "$@"; do
  case "$pair" in
    action=*) ACTION="${pair#action=}" ;;
  esac
done

echo "Content-type: application/json"
echo "Cache-Control: no-store"
echo

if [ "$ACTION" = "save" ] || [ "$ACTION" = "apply" ]; then
  tmp=/tmp/config.env.$$
  {
    echo "# config.env - generated by config.cgi"
    for k in $KEYS; do
      v=$(qval "$k" "$@"); [ -z "$v" ] && v=$(cur "$k"); [ -z "$v" ] && v=$(def "$k")
      echo "export $k=$v"
    done
  } > "$tmp"
  cp "$tmp" "$CFG" 2>/dev/null; rm -f "$tmp"
  sync
  if [ "$ACTION" = "apply" ]; then
    printf '{"ok":1,"applied":1}'
    ( sleep 1; reboot ) >/dev/null 2>&1 &
    exit 0
  fi
  printf '{"ok":1,"applied":0}'
  exit 0
fi

printf '{'
first=1
for k in $KEYS; do
  v=$(cur "$k"); [ -z "$v" ] && v=$(def "$k")
  [ "$first" = 1 ] || printf ','
  first=0
  printf '"%s":%s' "$k" "$v"
done
printf '}'
