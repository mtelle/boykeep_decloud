# config.env - web-editable settings for the de-cloud stack.
# Sourced by start.sh (overrides the built-in defaults). Edited by the web UI (config.cgi).
# After changing it, apply from the web (reboots the camera) or run: reboot
# Values are plain KEY=value; keep them numeric where numeric.

# --- Motion detection ---
export MD=1                 # 1=on, 0=off (no recording)
export MD_CELL_TH=80        # per-cell motion threshold (higher = less sensitive)
export MD_MIN_CELLS=6       # cells in motion needed to trigger (higher = less sensitive)
export MD_HOLD=8            # seconds to keep recording after motion stops
export MD_MAXCLIP=120       # max seconds per clip (then rotates at a keyframe)

# --- Audio ---
export MD_AUDIO=1           # 1=record audio (AAC) into the mp4, 0=video only

# --- Retention (auto-delete) ---
export MD_MINFREE=200       # keep at least this many MB free (deletes oldest first)
export MD_KEEPDAYS=0        # 0=off; otherwise delete clips older than N days

# --- OSD burned-in date/time ---
export OSD=1               # 1=show date/time on the video, 0=off
export OSD_X=16            # x position (pixels from left)
export OSD_Y=16            # y position (pixels from top)
export OSD_SCALE=2         # font scale (1..4)
export OSD_ALPHA=70        # overlay opacity 0..100
export OSD_FG=1           # text color index (board default color table)
export OSD_BG=0           # background color index
