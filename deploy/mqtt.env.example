# camqtt: MQTT bridge to Home Assistant (see docs/12-home-assistant.md).
# Copy to /mnt/sdcard/cam/etc/mqtt.env and fill in. NEVER commit the real file.
# No file, or MQTT_HOST empty -> camqtt is not started.
MQTT_HOST=homeassistant.local     # broker (HA Mosquitto add-on): hostname or IP
MQTT_PORT=1883
MQTT_USER=                        # an HA user, or a login from the Mosquitto add-on config
MQTT_PASS=
MQTT_NAME="Camera"                # device name shown in Home Assistant
MQTT_LANG=en                      # entity names: en | es
MQTT_SNAP_INT=60                  # seconds between snapshots (0 = only on motion / on request)
MQTT_PTZ_STEPS=300                # motor steps per PTZ button press
# MQTT_ID=cam_<mac>               # defaults: unique id from the WiFi MAC,
# MQTT_BASE=decloud/<id>          # topic root,
# MQTT_DISCOVERY=homeassistant    # HA discovery prefix
